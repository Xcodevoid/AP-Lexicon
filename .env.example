# --- Required ---
# PostgreSQL connection string
DATABASE_URL="postgresql://aplex:aplex@localhost:5432/aplexicon?schema=public"
# 32+ random chars; used to sign session cookies (openssl rand -hex 32)
SESSION_SECRET="change-me-to-a-long-random-string-change-me"

# --- Admin bootstrap (created/updated by `npm run db:seed`) ---
ADMIN_EMAIL="admin@aplexicon.local"
ADMIN_PASSWORD="change-this-admin-password"

# --- Demo mode ---
# When "true", the landing page offers "Try the demo", which creates an isolated,
# flagged demo account (User.isDemo = true). Demo accounts are excluded from
# leaderboards and can be purged with `npm run demo:purge`.
DEMO_MODE="true"

# --- Optional: AI-assisted Question Decoder (server-side only) ---
# Leave empty to run the decoder in deterministic mode only.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"
